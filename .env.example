# AgentTools — Macro Finance MCP Servers
# Copy this file to .env and fill in your keys

# FRED API (St. Louis Fed) — REQUIRED for US economic data
# Free: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Stats NZ — optional, for NZ-specific data
# Free registration: https://data.stats.govt.nz/
STATS_NZ_API_KEY=

# ABS Australia — optional
# Free registration: https://api.data.abs.gov.au/
ABS_API_KEY=

# ONS UK — optional
# Free registration: https://api.ons.gov.uk/
ONS_API_KEY=

# IMF Data API — registration required at https://data.imf.org/
# Note: the old dataservices.imf.org was decommissioned in 2025
IMF_API_KEY=

# World Bank API — no key needed (1,000 requests/day free tier)
# BIS Statistics API — no key needed
